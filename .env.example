# PlanEstrat · Variables de entorno
# Copia este archivo a .env y ajusta los valores.
# En Vercel, configura estas mismas variables en: Project Settings → Environment Variables

# Clave secreta de Django (genera una para producción con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=genera-una-clave-larga-y-aleatoria-aqui

# Modo debug (SIEMPRE False en producción)
DEBUG=True

# Hosts permitidos, separados por coma (agrega tu dominio de Vercel)
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app

# Orígenes de confianza para CSRF
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# --- Base de datos ---
# En local no necesitas definir nada: usa SQLite automáticamente.
# En producción (a partir de la Fase 3, app `decisiones`), usa un Postgres gratuito
# (Neon o Supabase) con la CADENA POOLED, imprescindible en serverless:
# DATABASE_URL=postgres://usuario:clave@host-pooler.region.neon.tech/basedatos?sslmode=require
